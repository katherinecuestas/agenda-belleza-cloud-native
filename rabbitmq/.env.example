# Copia este archivo como .env (queda fuera de git) y cambia los valores.
# Lo leen docker compose (usuario y cookie del cluster) y los microservicios (para conectarse).
RABBITMQ_USER=salon
RABBITMQ_PASS=cambia-esta-clave
# Cookie de Erlang: los 3 nodos DEBEN tener la misma o no forman cluster.
# Usa un valor aleatorio largo, por ejemplo: openssl rand -hex 32
RABBITMQ_COOKIE=cambia-esta-cookie-por-un-valor-aleatorio-largo
